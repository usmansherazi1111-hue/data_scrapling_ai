# Optional AI extraction. Leave empty to use deterministic extraction only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Local application
HOST=127.0.0.1
PORT=8000
DB_PATH=./data/scrapling.db

# Optional: Hunter.io domain search adds verified staff emails during enrichment
HUNTER_API_KEY=

# Password for the web UI. Leave empty only for local, unshared use.
APP_PASSWORD=

# Company registries. GLEIF (worldwide LEI data) is used with no key.
# Optional, free: UK Companies House REST API key (https://developer.company-information.service.gov.uk)
# adds every UK company with its directors.
COMPANIES_HOUSE_API_KEY=

# Optional: OpenCorporates company-registry API (https://opencorporates.com/api_accounts/new).
# Adds legal name, company number, status, incorporation date, registered address and directors
# to each crawl, and powers the "Company registry" search and bulk lookup. Uses the official API only.
OPENCORPORATES_API_TOKEN=
# Minimum seconds between API calls (keeps usage steady; does not bypass plan limits)
OPENCORPORATES_MIN_INTERVAL=1.0

# Contact shown in the User-Agent of registry API calls (your website or email).
APP_CONTACT=

# Find companies: how many companies are crawled at once, pages per company website, max list size.
COMPANY_CRAWL_CONCURRENCY=8
COMPANY_CRAWL_PAGES=6
COMPANY_LIST_MAX=200

# Fill empty fields: 0 turns a source off.
GAPFILL_NOMINATIM=1
COMPANY_TRY_ALT_URLS=1
# Official-register lookup for every listed company (slow, low match rate for small firms): 1 = on
GAPFILL_REGISTRY=0
